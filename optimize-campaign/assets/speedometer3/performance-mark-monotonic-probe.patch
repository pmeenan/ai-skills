 constexpr size_t kLongTaskUkmSampleInterval = 100;
+
+// Speedometer score-boundary timestamps are buffered so fprintf/fflush never
+// runs inside a score timer. A start is taken after Performance::mark work and
+// an end is taken before it, excluding the marker implementation itself.
+// Intentionally leaked and function-local: Blink forbids both non-trivial
+// thread_local destructors and namespace-scope dynamic initialization.
+using Sp3ScoreMarks = std::vector<std::pair<std::string, double>>;
+
+Sp3ScoreMarks& GetSp3ScoreMarks() {
+  thread_local auto* marks = new Sp3ScoreMarks;
+  return *marks;
+}
+
+thread_local bool sp3_collecting_score_marks = false;
+
+bool IsSpeedometerScoreStart(const AtomicString& name) {
+  return name.contains(".") && name.ends_with("-start");
+}
+
+bool IsSpeedometerScoreEnd(const AtomicString& name) {
+  return name.contains(".") &&
+         (name.ends_with("-sync-end") || name.ends_with("-async-end"));
+}
+
+void FlushSpeedometerScoreMarks() {
+  for (const auto& [name, timestamp] : GetSp3ScoreMarks())
+    std::fprintf(stderr, "[SP3_SCORE_TIME] %s: %.9f\n", name.c_str(), timestamp);
+  std::fflush(stderr);
+  GetSp3ScoreMarks().clear();
+}
 
