+  if (sp3_outer_start) {
+    GetSp3ScoreMarks().clear();
+    sp3_collecting_score_marks = true;
+  }
+  if (sp3_score_end || sp3_outer_end) {
+    GetSp3ScoreMarks().emplace_back(
+        mark_name.Utf8().c_str(),
+        base::TimeTicks::Now().since_origin().InSecondsF());
+  }
